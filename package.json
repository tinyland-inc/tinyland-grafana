{
  "name": "@tinyland-inc/tinyland-grafana",
  "version": "0.1.0",
  "description": "Grafana API client, configuration, and dashboard definitions for Tinyland observability",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./dashboards/*": "./src/dashboards/*.json"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "grafana",
    "observability",
    "dashboards",
    "monitoring"
  ],
  "author": "Tinyland Inc.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/tinyland/packages/tinyland-grafana"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@tinyland-inc/tinyland-otel": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tinyland-inc/tinyland-otel": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
