{
  "name": "@tummycrypt/tinyland-grafana",
  "version": "1.0.0",
  "private": true,
  "description": "Grafana API client, configuration, and dashboard definitions for Tinyland observability",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dashboards/*": "./dist/dashboards/*.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "grafana",
    "observability",
    "dashboards",
    "monitoring"
  ],
  "author": "Tinyland Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-grafana.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.19.0",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-grafana",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-grafana/issues"
  }
}
