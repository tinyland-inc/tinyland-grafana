{
  "name": "@tummycrypt/tinyland-grafana",
  "version": "0.2.3",
  "description": "Grafana API client, configuration, and dashboard definitions for Tinyland observability",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dashboards/*": "./dist/dashboards/*.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build && pnpm check:package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "grafana",
    "observability",
    "dashboards",
    "monitoring"
  ],
  "author": "Tinyland Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyland-inc/tinyland-grafana.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "publint": "^0.3.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/tinyland-inc/tinyland-grafana",
  "bugs": {
    "url": "https://github.com/tinyland-inc/tinyland-grafana/issues"
  }
}