{
  "name": "@tummycrypt/tinyland-grafana",
  "version": "0.1.0",
  "description": "Grafana API client, configuration, and dashboard definitions for Tinyland observability",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dashboards/*": "./dist/dashboards/*.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "grafana",
    "observability",
    "dashboards",
    "monitoring"
  ],
  "author": "Tinyland Inc.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/tinyland/projects/tinyland.dev.git",
    "directory": "packages/tinyland-grafana"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@tummycrypt/tinyland-otel": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tummycrypt/tinyland-otel": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  }
}
