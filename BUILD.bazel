"""
BUILD.bazel for @tummycrypt/tinyland-grafana.

Dual-mode build: works with both pnpm (standalone) and Bazel (CI/production).
  Standalone: cd packages/tinyland-grafana && pnpm test

Provides Grafana API client, configuration, and dashboard JSON definitions.
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_grafana_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_grafana_npm//:vitest/package_json.bzl", vitest_bin = "bin")

# =============================================================================
# npm link - makes node_modules available for this package
# =============================================================================

npm_link_all_packages(name = "node_modules")

# First-party dep resolved via the Bazel module graph (not npm).
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-otel",
    src = "@tummycrypt_tinyland_otel//:pkg",
)


# =============================================================================
# Dashboard JSON data files
# =============================================================================

filegroup(
    name = "dashboards",
    srcs = glob(["src/dashboards/*.json"]),
    visibility = ["//visibility:public"],
)

# =============================================================================
# TypeScript compilation
# =============================================================================

ts_project(
    name = "tinyland_grafana",
    srcs = glob(
        [
            "src/**/*.ts",
            "src/**/*.json",
        ],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    data = [":dashboards"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    # Emit JS to an intermediate dir so it doesn't collide with the assembled
    # ":dist" TreeArtifact below. `--outDir dist_ts` is passed to tsc, overriding
    # the tsconfig `outDir`; validate=False disables the consistency check.
    out_dir = "dist_ts",
    root_dir = "src",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@tummycrypt/tinyland-otel",
        ":node_modules/@types/node",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Assembled dist/ TreeArtifact
# =============================================================================
#
# tsc (resolveJsonModule) leaves `import ... from './dashboards/*.json'` in the
# emitted dist/index.js but never copies the .json into out_dir, and the
# ":dashboards" filegroup keeps them at their src/ path. Merge the ts_project JS
# output (dist_ts/*.js) with the dashboard JSON (src/dashboards/*.json) into a
# single dist/ tree so dist/index.js and dist/dashboards/*.json ship together.
# root_paths strips the "dist_ts" and "src" package-relative prefixes so JS lands
# at dist/<file>.js and JSON nests at dist/dashboards/<file>.json.
copy_to_directory(
    name = "dist",
    srcs = [
        ":dashboards",
        ":tinyland_grafana",
    ],
    root_paths = [
        "dist_ts",
        "src",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# npm package target
# =============================================================================

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":dist",
    ],
    package = "@tummycrypt/tinyland-grafana",
    version = "0.2.4",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Test targets
# =============================================================================

vitest_bin.vitest_test(
    name = "test",
    data = [

                ":dashboards",
        ":node_modules",
        ":node_modules/@tummycrypt/tinyland-otel",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + glob(["src/**/*.ts"]) + glob(["tests/**/*.test.ts", "tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Typecheck-only target (no emit)
# =============================================================================

ts_project(
    name = "typecheck",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.json",
    ]) + ["package.json"],
    data = [":dashboards"],
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@tummycrypt/tinyland-otel",
        ":node_modules/@types/node",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Exported files for downstream consumers
# =============================================================================

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
